{
  "id": "temp_above",
  "title": {
    "en": "Temperature is above…",
    "nl": "Temperatuur is boven…"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "title": {
        "en": "Device",
        "nl": "Apparaat"
      },
      "filter": "driver_id=solar_controller"
    },
    {
      "name": "threshold",
      "type": "number",
      "title": {
        "en": "Threshold (°C)",
        "nl": "Drempel (°C)"
      },
      "min": -20,
      "max": 120,
      "step": 0.5
    }
  ],
  "titleFormatted": {
    "en": "Temperature > [[threshold]] °C",
    "nl": "Temperatuur > [[threshold]] °C"
  }
}
